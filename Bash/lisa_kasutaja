#!/bin/bash
# Ülesanne 1 - Kasutaja loomine käsurealise parameetri abil

# Kontrollime parameetrite arvu
if [ $# -ne 1 ]; then
    echo "Kasutusjuhend: $0 kasutajanimi"
    exit 1
fi

kasutajanimi="$1"

# Kontrollime, kas kasutaja on juba süsteemis olemas
if id "$kasutajanimi" &>/dev/null; then
    echo "Kasutaja '$kasutajanimi' on juba süsteemis olemas!"
    exit 1
fi

# Kasutaja loomine koos kodukataloogiga (-m kopeerib ka peidetud failid /etc/skel kaustast)
useradd -m -s /bin/bash "$kasutajanimi"

# Tulemuse kontroll
if [ $? -eq 0 ]; then
    echo "Kasutaja '$kasutajanimi' on edukalt loodud."
    grep "^$kasutajanimi:" /etc/passwd
else
    echo "Viga: Kasutaja '$kasutajanimi' loomine ebaõnnestus!"
    exit 1
fi
